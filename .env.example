# Copy to .env for local development. Never commit .env — it's gitignored.
# In production these are set as Netlify site environment variables, not here.

# Random token used as the URL path for the hidden remote-access page.
REMOTE_PAGE_SLUG=

# Password required to load the hidden remote-access page (checked server-side
# by netlify/edge-functions/gate.ts). Independent from the ttyd/Fedora password.
REMOTE_PAGE_PASSWORD=

# Public Tailscale Funnel URL the hidden page links to.
PUBLIC_REMOTE_URL=
